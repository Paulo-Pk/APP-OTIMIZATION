<Window x:Class="PCControlUltimate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCControlUltimate.App.ViewModels"
        xmlns:views="clr-namespace:PCControlUltimate.App.Views"
        Title="{Binding Loc[AppTitle]}"
        Height="920" Width="1540"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="#07090E"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Core Preview Palette Brushes -->
        <SolidColorBrush x:Key="CanvasBackground" Color="#07090E" />
        <SolidColorBrush x:Key="HeaderBackground" Color="#0D0F17" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#0A0C13" />
        <SolidColorBrush x:Key="CardBackground" Color="#0F121B" />
        <SolidColorBrush x:Key="CardElevatedBackground" Color="#131722" />
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7" />
        <SolidColorBrush x:Key="AccentViolet" Color="#7C3AED" />
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4" />
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981" />
        <SolidColorBrush x:Key="AccentRose" Color="#F43F5E" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="BorderDark" Color="#1E2436" />
        <SolidColorBrush x:Key="BorderPurpleSubtle" Color="#3B1D6E" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />

        <LinearGradientBrush x:Key="HeroBannerGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#121520" Offset="0.0" />
            <GradientStop Color="#151928" Offset="0.5" />
            <GradientStop Color="#11131C" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#9333EA" Offset="0.0" />
            <GradientStop Color="#7C3AED" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Modern ProgressBar Style -->
        <Style x:Key="TelemetryProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#A855F7" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Technical Details Expander Style (Collapsed by default per user preference) -->
        <Style x:Key="TechnicalExpanderStyle" TargetType="Expander">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Foreground" Value="#C084FC" />
            <Setter Property="Background" Value="#0A0C13" />
            <Setter Property="BorderBrush" Value="#1E2436" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Sidebar Navigation Button with Icon Support (Path inUid) and Active Highlight -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="NavIcon"
                                      Grid.Column="0"
                                      Data="{Binding Uid, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="#64748B"
                                      Stretch="Uniform"
                                      Width="14" Height="14"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <Ellipse x:Name="ActiveIndicator"
                                         Grid.Column="2"
                                         Width="6" Height="6"
                                         Fill="#A855F7"
                                         Visibility="Collapsed"
                                         VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#131724" />
                                <Setter Property="Foreground" Value="#E2E8F0" />
                                <Setter TargetName="NavIcon" Property="Fill" Value="#C084FC" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#24163D" />
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#9333EA" />
                                <Setter Property="Foreground" Value="#F3E8FF" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter TargetName="NavIcon" Property="Fill" Value="#C084FC" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="ActionPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PurpleButtonGradient}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#A855F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A855F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="ActionSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#161A27" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2E364F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2537" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A855F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================================= -->
        <!-- 1. DASHBOARD VIEW TEMPLATE (Preview Reference Layout)                     -->
        <!-- ========================================================================= -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView>
                <StackPanel>
                    <!-- Hero Overview Banner with Health Score Ring -->
                    <Border Background="{StaticResource HeroBannerGradient}" BorderBrush="{StaticResource BorderPurpleSubtle}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="PAINEL DE CONTROLE ULTIMATE · WINDOWS 11 PRO X64" Foreground="#C084FC" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="PC CONTROL ULTIMATE" Foreground="#FFFFFF" FontSize="24" FontWeight="Black" Margin="0,4,0,6" />
                                <TextBlock Text="{Binding Workspace.Loc[HeaderDesc]}" Foreground="{StaticResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#0D0F17" BorderBrush="#4C1D95" BorderThickness="1" CornerRadius="12" Padding="18,12" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="58" Height="58" Margin="0,0,14,0">
                                        <Ellipse Stroke="#1F2438" StrokeThickness="5" />
                                        <Ellipse Stroke="#A855F7" StrokeThickness="5" StrokeDashArray="28 6" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Workspace.OverallHealthScore}" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="17" FontWeight="Black" HorizontalAlignment="Center" />
                                            <TextBlock Text="PTS" Foreground="#94A3B8" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Saúde Geral do Sistema" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock Text="{Binding Workspace.HardwareSubsystemStatusText}" Foreground="#10B981" FontSize="12.5" FontWeight="Bold" Margin="0,2,0,2" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Workspace.LastBackupStatus}" Foreground="#64748B" FontFamily="Consolas" FontSize="10.5" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Primary 4-Column Hardware KPI Cards Grid -->
                    <UniformGrid Columns="4" Margin="0,0,0,18">
                        <!-- Card 1: CPU -->
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Workspace.Loc[CardCpuTitle]}" Foreground="#CBD5E1" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Workspace.CpuLoad}" Foreground="#C084FC" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                                </DockPanel>
                                <TextBlock Text="{Binding Workspace.CpuModel}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                <Border BorderBrush="#1E2436" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,4,6">
                                            <TextBlock Text="Temperatura" Foreground="#64748B" FontSize="10" />
                                            <TextBlock Text="{Binding Workspace.CpuTemp}" Foreground="#E2E8F0" FontFamily="Consolas" FontWeight="Bold" FontSize="13" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="Frequência / Potência" Foreground="#64748B" FontSize="10" />
                                            <TextBlock Foreground="#E2E8F0" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12">
                                                <Run Text="{Binding Workspace.CpuClock}" />
                                                <Run Text=" · " Foreground="#64748B" />
                                                <Run Text="{Binding Workspace.CpuPower}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>
                                <ProgressBar Style="{StaticResource TelemetryProgressBar}" Value="{Binding Workspace.CpuLoadPercent}" Foreground="#A855F7" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Primary GPU (Discrete AMD / NVIDIA / Intel Arc or Integrated) -->
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="5,0,5,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Workspace.Loc[CardGpuTitle]}" Foreground="#CBD5E1" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Workspace.GpuLoad}" Foreground="#FB7185" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                                </DockPanel>
                                <TextBlock Text="{Binding Workspace.GpuModel}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                <Border BorderBrush="#1E2436" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,4,6">
                                            <TextBlock Text="Core / Hotspot" Foreground="#64748B" FontSize="10" />
                                            <TextBlock FontFamily="Consolas" FontWeight="Bold" FontSize="12.5">
                                                <Run Text="{Binding Workspace.GpuTemp}" Foreground="#E2E8F0" />
                                                <Run Text=" / " Foreground="#64748B" />
                                                <Run Text="{Binding Workspace.GpuHotspot}" Foreground="#FBBF24" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="Delta Hotspot (ΔT)" Foreground="#64748B" FontSize="10" />
                                            <TextBlock Text="{Binding Workspace.GpuHotspotDeltaText}" Foreground="#34D399" FontFamily="Consolas" FontWeight="Bold" FontSize="12.5" />
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>
                                <ProgressBar Style="{StaticResource TelemetryProgressBar}" Value="{Binding Workspace.GpuLoadPercent}" Foreground="#F43F5E" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Physical RAM -->
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="5,0,5,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Workspace.Loc[CardRamTitle]}" Foreground="#CBD5E1" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Workspace.RamUsagePercent, StringFormat='{}{0:F0}%'}" Foreground="#22D3EE" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" />
                                </DockPanel>
                                <TextBlock Text="{Binding Workspace.RamUsage}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                <Border BorderBrush="#1E2436" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="GPU VRAM Alocada" Foreground="#64748B" FontSize="10" />
                                        <TextBlock Text="{Binding Workspace.GpuVram}" Foreground="#E2E8F0" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12.5" />
                                    </StackPanel>
                                </Border>
                                <ProgressBar Style="{StaticResource TelemetryProgressBar}" Value="{Binding Workspace.RamUsagePercent}" Foreground="#06B6D4" />
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Display & Subsystem -->
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="10,0,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Workspace.Loc[CardDisplayTitle]}" Foreground="#CBD5E1" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="WIN32" Foreground="#34D399" FontFamily="Consolas" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" />
                                </DockPanel>
                                <TextBlock Text="{Binding Workspace.DisplayInfoText}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                <Border BorderBrush="#1E2436" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Rotação Ventoinha GPU" Foreground="#64748B" FontSize="10" />
                                        <TextBlock Text="{Binding Workspace.GpuFanRpm}" Foreground="#E2E8F0" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12.5" />
                                    </StackPanel>
                                </Border>
                                <ProgressBar Style="{StaticResource TelemetryProgressBar}" Value="100" Foreground="#10B981" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Telemetry Visual Panel + Quick Optimization Callout -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: GPU Thermal & Real-Time Telemetry Summary -->
                        <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="TELEMETRIA EM TEMPO REAL &amp; DIAGNÓSTICO TÉRMICO GPU" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="8" Height="8" Fill="#A855F7" Margin="0,0,5,0" />
                                        <TextBlock Text="CPU Load" Foreground="#C084FC" FontFamily="Consolas" FontSize="11" Margin="0,0,14,0" />
                                        <Ellipse Width="8" Height="8" Fill="#F43F5E" Margin="0,0,5,0" />
                                        <TextBlock Text="GPU Load" Foreground="#FB7185" FontFamily="Consolas" FontSize="11" Margin="0,0,14,0" />
                                        <Ellipse Width="8" Height="8" Fill="#06B6D4" Margin="0,0,5,0" />
                                        <TextBlock Text="Hotspot ΔT" Foreground="#22D3EE" FontFamily="Consolas" FontSize="11" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Workspace.GpuThermalDiagnosisText}" Foreground="#FBBF24" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding Workspace.Loc[GpuHealthNotice]}" Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="3">
                                    <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="CPU Clock / Package" Foreground="#64748B" FontSize="10.5" />
                                            <TextBlock Text="{Binding Workspace.CpuClock}" Foreground="#E2E8F0" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="GPU Clock / Potência" Foreground="#64748B" FontSize="10.5" />
                                            <TextBlock Foreground="#E2E8F0" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,3,0,0">
                                                <Run Text="{Binding Workspace.GpuClock}" />
                                                <Run Text=" · " Foreground="#64748B" />
                                                <Run Text="{Binding Workspace.GpuPower}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Rota de Jogos (Accelerator)" Foreground="#64748B" FontSize="10.5" />
                                            <TextBlock Text="AllowedIPs Seletivo" Foreground="#34D399" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Right: Quick Optimization Callout Card -->
                        <Border Grid.Column="1" Background="#121626" BorderBrush="#3B1D6E" BorderThickness="1" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="OTIMIZAÇÃO RÁPIDA REVERSÍVEL" Foreground="#C084FC" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="Aplica ajustes seguros do catálogo fechado com captura automática de Snapshot SHA-256 e registro no Ledger DPAPI+HMAC." Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,14" />

                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Nível de Risco" Foreground="#94A3B8" FontSize="11.5" />
                                            <TextBlock Text="Zero Risco (Catálogo Seguro)" Foreground="#34D399" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="Proteção de Reversão" Foreground="#94A3B8" FontSize="11.5" />
                                            <TextBlock Text="Ledger DPAPI + SHA-256" Foreground="#C084FC" FontFamily="Consolas" FontSize="11.5" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Último Backup" Foreground="#94A3B8" FontSize="11.5" />
                                            <TextBlock Text="{Binding Workspace.LastBackupStatus}" Foreground="#E2E8F0" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource ActionPrimaryButton}"
                                        Content="{Binding Workspace.Loc[BtnApplySafeBoost]}"
                                        Command="{Binding Workspace.ApplySafeBoostProfileCommand}"
                                        HorizontalAlignment="Stretch"
                                        Padding="14,11" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Technical Details On Demand (Collapsed by Default) -->
                    <Expander Style="{StaticResource TechnicalExpanderStyle}" Header="{Binding Workspace.Loc[ViewTechnicalDetails]}">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="MATRIZ DE CAPACIDADES E SEGURANÇA DOS 17 MÓDULOS" Foreground="#FFFFFF" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Workspace.ModuleCapabilityMatrix}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1E2436" BorderThickness="0,0,0,1" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='#{0:D2}'}" Foreground="#64748B" FontFamily="Consolas" FontSize="11" />
                                                <TextBlock Grid.Column="1" Text="{Binding ModuleName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5" />
                                                <TextBlock Grid.Column="2" Text="{Binding ImplementationState}" Foreground="#34D399" FontFamily="Consolas" FontSize="11" />
                                                <TextBlock Grid.Column="3" Text="{Binding BackendEngine}" Foreground="#C084FC" FontFamily="Consolas" FontSize="11" />
                                                <TextBlock Grid.Column="4" Text="{Binding LimitationsAndSafetyNote}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </views:DashboardView>
        </DataTemplate>

        <!-- ========================================================================= -->
        <!-- 2. HARDWARE MONITOR VIEW TEMPLATE                                         -->
        <!-- ========================================================================= -->
        <DataTemplate DataType="{x:Type vm:HardwareMonitorViewModel}">
            <views:HardwareMonitorView>
                <StackPanel>
                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Workspace.Loc[HardwareStateHeader]}" Foreground="#C084FC" FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="{Binding Workspace.HardwareSubsystemStatusText}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="0,4,0,14" />

                            <UniformGrid Columns="4">
                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="CPU Package &amp; Clock" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock Text="{Binding Workspace.CpuModel}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,6" />
                                        <TextBlock Text="{Binding Workspace.CpuTemp}" Foreground="#C084FC" FontFamily="Consolas" FontSize="16" FontWeight="Black" />
                                        <TextBlock Text="{Binding Workspace.CpuClock}" Foreground="#64748B" FontFamily="Consolas" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="GPU Dedicada (Prioritária)" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock Text="{Binding Workspace.GpuModel}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,6" />
                                        <TextBlock Text="{Binding Workspace.GpuTemp}" Foreground="#FB7185" FontFamily="Consolas" FontSize="16" FontWeight="Black" />
                                        <TextBlock Text="{Binding Workspace.GpuClock}" Foreground="#64748B" FontFamily="Consolas" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="Memória RAM &amp; VRAM" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock Text="{Binding Workspace.RamUsage}" Foreground="#22D3EE" FontFamily="Consolas" FontSize="15" FontWeight="Black" Margin="0,6,0,4" />
                                        <TextBlock Text="{Binding Workspace.GpuVram}" Foreground="#64748B" FontFamily="Consolas" FontSize="11.5" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Ventoinhas &amp; Display" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock Text="{Binding Workspace.GpuFanRpm}" Foreground="#34D399" FontFamily="Consolas" FontSize="15" FontWeight="Black" Margin="0,6,0,4" />
                                        <TextBlock Text="{Binding Workspace.DisplayInfoText}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Expander Style="{StaticResource TechnicalExpanderStyle}" Header="{Binding Workspace.Loc[ViewTechnicalDetails]}">
                        <ItemsControl ItemsSource="{Binding Workspace.AllHardwareSensors}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#1E2436" BorderThickness="0,0,0,1" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Category}" Foreground="#C084FC" FontFamily="Consolas" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E2E8F0" FontSize="12" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="#38BDF8" FontFamily="Consolas" FontWeight="Bold" FontSize="12" />
                                            <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </views:HardwareMonitorView>
        </DataTemplate>

        <!-- ========================================================================= -->
        <!-- 3. GPU HEALTH LAB VIEW TEMPLATE (Dedicated GPU Priority + Hotspot Delta)  -->
        <!-- ========================================================================= -->
        <DataTemplate DataType="{x:Type vm:GpuHealthLabViewModel}">
            <views:GpuHealthLabView>
