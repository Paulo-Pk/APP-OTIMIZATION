                            <TextBlock Text="Inspeciona processos de jogos em execução no Windows e mapeia conexões remotas TCP/UDP para diagnóstico de rota e telemetria." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ActionSecondaryButton}" Command="{Binding RefreshProcessesCommand}" Margin="0,0,10,0">
                                <TextBlock Text="Atualizar Processos"/>
                            </Button>
                            <Button Style="{StaticResource ActionPrimaryButton}"
                                    Command="{Binding RefreshGameConnectionsCommand}"
                                    IsEnabled="{Binding CanRefreshGameConnections}">
                                <TextBlock Text="{Binding RefreshGameConnectionsButtonText}"/>
