                                                                CommandParameter="{Binding}"
                                                                Margin="0,0,8,0" />
                                                        <Button Style="{StaticResource ActionSecondaryButton}"
                                                                Content="{Binding DataContext.Workspace.Loc[BtnRestoreTweak], RelativeSource={RelativeSource AncestorType=views:RegistryOptimizerView}}"
                                                                Command="{Binding DataContext.Workspace.RestoreSingleTweakCommand, RelativeSource={RelativeSource AncestorType=views:RegistryOptimizerView}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Expander Style="{StaticResource TechnicalExpanderStyle}" Header="{Binding DataContext.Workspace.Loc[ViewTechnicalDetails], RelativeSource={RelativeSource AncestorType=views:RegistryOptimizerView}}">
