<Window x:Class="PCControlUltimate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PC Control Ultimate"
        Icon="pack://application:,,,/Assets/pc-control.ico"
        Height="920" Width="1540" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#07090E" Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Grid Background="#07090E">
        <wv2:WebView2 x:Name="AppWebView"
                      ZoomFactor="1.0" />
        <Border x:Name="StartupOverlay" Background="#07090E" Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                <TextBlock Text="PC CONTROL ULTIMATE" Foreground="#C084FC"
                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StartupStatus" Text="Preparando interface..."
                           Foreground="#94A3B8" FontSize="13" Margin="0,14,0,0"
                           TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>