                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="BAIXA LATÊNCIA" FontSize="10" FontWeight="Bold" Foreground="#C084FC"/>
                            <TextBlock Text="Competitive Gaming" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,6"/>
                            <TextBlock Text="Prioriza responsividade de DWM, GameDVR e agendamento multimídia para menor frametime." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>
