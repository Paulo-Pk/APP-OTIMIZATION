                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource LangQuickButtonStyle}" Content="PT"
                                                Command="{Binding SetLanguagePtCommand}" Tag="{Binding IsPortugueseActive}" Margin="0,0,4,0"/>
                                        <Button Style="{StaticResource LangQuickButtonStyle}" Content="EN"
                                                Command="{Binding SetLanguageEnCommand}" Tag="{Binding IsEnglishActive}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Active Profile Row -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Perfil Ativo" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding DetectedProfileDisplay}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#C084FC" FontFamily="Consolas"/>
                                </Grid>

                                <!-- RAM Telemetry Bar -->
                                <ProgressBar Style="{StaticResource TelemetryProgressBar}" Value="{Binding RamUsagePercent}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="RAM" FontSize="10" Foreground="#64748B" FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding RamUsageWithPercent}" HorizontalAlignment="Right" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas"/>
                                </Grid>

                                <!-- Mandatory Author Signature -->
                                <Border BorderBrush="#1E2436" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <TextBlock Text="DESENVOLVIDO POR PAULO_PK" HorizontalAlignment="Center"
                                               FontSize="10" FontWeight="Bold" FontFamily="Consolas" Foreground="#C084FC"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA (Single Clean Canvas without Duplicate Top/Bottom Bars) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource BgCanvasBrush}" Padding="24">
                <ContentControl Content="{Binding Navigation.CurrentViewModel}" MaxWidth="1560"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>