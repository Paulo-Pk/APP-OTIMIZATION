                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Workspace.Loc[BenchmarksTitle]}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" />
