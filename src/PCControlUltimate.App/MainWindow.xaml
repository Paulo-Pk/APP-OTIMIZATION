                            <TextBlock Text="{Binding Workspace.Loc[TweaksTitle]}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="{Binding Workspace.Loc[TweaksSubtitle]}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding Workspace.CatalogTweaks}">
