                                <TextBlock Text="{Binding Workspace.BenchmarkResultSummary}" Foreground="#C084FC" FontFamily="Consolas" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </views:BenchmarkCenterView>
        </DataTemplate>

        <!-- ========================================================================= -->
        <!-- 8. DIAGNOSTICS VIEW TEMPLATE                                              -->
