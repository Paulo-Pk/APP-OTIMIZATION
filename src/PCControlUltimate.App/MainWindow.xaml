                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ========================================================================= -->
        <!-- 3. GAME CENTER VIEW                                                       -->
        <!-- ========================================================================= -->
