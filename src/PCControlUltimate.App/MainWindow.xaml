                                                    </StackPanel>
                                                    <TextBlock Text="{Binding KeyPath}" Foreground="#94A3B8" FontFamily="Consolas" FontSize="10.5" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </views:DiagnosticsView>
        </DataTemplate>

