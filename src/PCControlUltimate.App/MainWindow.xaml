                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="BIBLIOTECA DETECTADA AUTOMATICAMENTE" FontSize="10" FontWeight="Bold" Foreground="#C084FC"/>
                                <TextBlock Text="Jogos Instalados (Steam, Epic, GOG, Ubisoft, EA e Xbox / Microsoft Store)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                                <TextBlock Text="Leitura dos catálogos e registros dos launchers compatíveis; não varre o disco inteiro nem inicia jogos." FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding InstalledGames.Count, StringFormat='Jogos encontrados: {0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>
                        <DataGrid ItemsSource="{Binding InstalledGames}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="220">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Jogo" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="6" Background="#24163F" BorderBrush="#7C3AED" BorderThickness="1" Margin="0,0,8,0">
                                                    <TextBlock Text="🎮" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Launcher" Binding="{Binding Launcher}" Width="120"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding AppId}" Width="150"/>
                                <DataGridTextColumn Header="Pasta de instalação" Binding="{Binding InstallLocation}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="A biblioteca identifica jogos instalados nos launchers compatíveis. As conexões do servidor são identificadas separadamente quando o jogo está aberto." FontSize="10.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Sockets TCP/UDP de Jogos Detectados em Tempo Real" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                            <DataGrid ItemsSource="{Binding DetectedGameSockets}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="380">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="75"/>
                                    <DataGridTextColumn Header="Processo" Binding="{Binding ProcessName}" Width="160"/>
                                    <DataGridTextColumn Header="Protocolo" Binding="{Binding Protocol}" Width="85"/>
                                    <DataGridTextColumn Header="Endpoint Local" Binding="{Binding LocalEndpoint}" Width="150"/>
                                    <DataGridTextColumn Header="Servidor Remoto" Binding="{Binding RemoteEndpoint}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Processos de Aplicações &amp; Jogos Ativos" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                            <DataGrid ItemsSource="{Binding AvailableProcesses}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="380">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="75"/>
                                    <DataGridTextColumn Header="Executável" Binding="{Binding ProcessName}" Width="140"/>
                                    <DataGridTextColumn Header="Título da Janela" Binding="{Binding MainWindowTitle}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- ========================================================================= -->
        <!-- 4. HARDWARE MONITOR VIEW                                                  -->
