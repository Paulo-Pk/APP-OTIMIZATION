                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderPurpleSubtle}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Workspace.Loc[GpuHealthTitle]}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="Prioridade GPU Discreta Ativa" Foreground="#34D399" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" />
                            </DockPanel>
                            <TextBlock Text="{Binding Workspace.GpuModel}" Foreground="#C084FC" FontSize="18" FontWeight="Black" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Workspace.Loc[GpuHealthNotice]}" Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="GPU Core (Edge)" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock Text="{Binding Workspace.GpuTemp}" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="20" FontWeight="Black" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="GPU Hotspot (Junction)" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock Text="{Binding Workspace.GpuHotspot}" Foreground="#FBBF24" FontFamily="Consolas" FontSize="20" FontWeight="Black" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="Delta Core/Hotspot (ΔT)" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock Text="{Binding Workspace.GpuHotspotDeltaText}" Foreground="#34D399" FontFamily="Consolas" FontSize="20" FontWeight="Black" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="VRAM &amp; Fan RPM" Foreground="#94A3B8" FontSize="11" />
                                        <TextBlock Text="{Binding Workspace.GpuVram}" Foreground="#38BDF8" FontFamily="Consolas" FontSize="13.5" FontWeight="Bold" Margin="0,4,0,2" />
                                        <TextBlock Text="{Binding Workspace.GpuFanRpm}" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11.5" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="#0A0C13" BorderBrush="#3B1D6E" BorderThickness="1" CornerRadius="10" Padding="16">
                                <TextBlock Text="{Binding Workspace.GpuThermalDiagnosisText}" Foreground="#FBBF24" FontFamily="Consolas" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </views:GpuHealthLabView>
        </DataTemplate>

        <!-- ========================================================================= -->
        <!-- 4. BOOST CENTER VIEW TEMPLATE                                             -->
        <!-- ========================================================================= -->
        <DataTemplate DataType="{x:Type vm:BoostCenterViewModel}">
            <views:BoostCenterView>
                <StackPanel>
                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderPurpleSubtle}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Workspace.Loc[BoostCenterTitle]}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="{Binding Workspace.Loc[BoostCenterSubtitle]}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap" />

                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="PERFIL CONSERVADOR" Foreground="#34D399" FontSize="11" FontWeight="Bold" />
                                        <TextBlock Text="Estabilidade &amp; Baixo Ruído" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="0,4,0,6" />
                                        <TextBlock Text="Aplica apenas ajustes HKCU de baixo impacto com reversão imediata via Ledger DPAPI." Foreground="#94A3B8" FontSize="11.5" TextWrapping="Wrap" />
