                                <CheckBox IsChecked="{Binding Workspace.ConfirmRestoreExecution}" Content="{Binding Workspace.Loc[ChkConfirmRestoreExecution]}" Foreground="#34D399" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <CheckBox IsChecked="{Binding Workspace.ConfirmIncompleteRestore}" Content="{Binding Workspace.Loc[ChkConfirmIncomplete]}" Foreground="#CBD5E1" Margin="0,0,0,4" />
