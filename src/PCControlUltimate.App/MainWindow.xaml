            <StackPanel DataContext="{Binding Workspace}">
                <Border Style="{StaticResource HeroBannerBorderStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="DIAGNÓSTICO TÉRMICO MULTI-VENDOR (AMD / NVIDIA / INTEL)" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,4"/>
