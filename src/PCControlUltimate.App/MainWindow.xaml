                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource ActionSecondaryButton}" Content="{Binding Workspace.Loc[BtnDryRunScan]}" Command="{Binding Workspace.SimulateDryRunCommand}" Margin="0,0,14,0" />
                                <CheckBox IsChecked="{Binding Workspace.ConfirmCleanerDeletion}" Content="{Binding Workspace.Loc[ChkConfirmDeletion]}" Foreground="#FDE047" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding Workspace.DebloatSummaryText}" Foreground="#38BDF8" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Margin="0,0,0,14" />

                            <ItemsControl ItemsSource="{Binding Workspace.CleanerCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
