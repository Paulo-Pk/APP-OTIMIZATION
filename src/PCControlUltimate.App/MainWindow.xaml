    <!-- ========================================================================= -->
    <!-- MAIN APPLICATION SHELL (HEADER + 17-MODULE SIDEBAR + WORKSPACE + FOOTER)  -->
    <!-- ========================================================================= -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar (Matching Preview Header.tsx) -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Zone 1: Brand Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource PurpleButtonGradient}" BorderBrush="#C084FC" BorderThickness="1" Margin="0,0,12,0">
                        <Path Data="M13 2L3 14h9l-1 8 10-12h-9l1-8z" Fill="#FFFFFF" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PC CONTROL" Foreground="#FFFFFF" FontWeight="Black" FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text=" ULTIMATE" Foreground="#C084FC" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <TextBlock Text="v2.5.0 .NET 10 LTS" Foreground="#64748B" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- Zone 2: Center Native Agent Connection Status -->
                <Border Grid.Column="1" Background="#131622" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="6" Padding="14,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#6EE7B7" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Zone 3: Right Controls & Boost Action -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ActionSecondaryButton}" Content="{Binding Loc[BtnSwitchLang]}" Command="{Binding ToggleLanguageCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource ActionSecondaryButton}" Content="{Binding Loc[BtnElevateUac]}" Command="{Binding RequestElevationCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource ActionSecondaryButton}" Content="{Binding Loc[BtnCreateBackup]}" Command="{Binding CreateSnapshotCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource ActionPrimaryButton}" Content="BOOST NOW" Command="{Binding ApplySafeBoostProfileCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 17-Module Sidebar Navigation with Vector Icons & Active State -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,14">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[NavSection]}" Foreground="#C084FC" FontSize="10" FontWeight="Bold" Margin="10,0,0,8" />

