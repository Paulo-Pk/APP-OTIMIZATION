<Window x:Class="PCControlUltimate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCControlUltimate.App.ViewModels"
        Title="PC Control Ultimate — Universal Windows 10/11 Optimization &amp; Telemetry"
        Height="920" Width="1540" MinHeight="740" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="#07090E" Foreground="#F8FAFC" FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Palette Tokens (Synchronized 1:1 with React Preview) -->
        <SolidColorBrush x:Key="BgBaseBrush" Color="#07090E"/>
        <SolidColorBrush x:Key="BgCanvasBrush" Color="#080A11"/>
        <SolidColorBrush x:Key="BgHeaderBrush" Color="#0D0F17"/>
        <SolidColorBrush x:Key="BgSidebarBrush" Color="#0A0C13"/>
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="#0F121B"/>
        <SolidColorBrush x:Key="BgElevatedBrush" Color="#141824"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1E2436"/>
        <SolidColorBrush x:Key="BorderHoverBrush" Color="#334155"/>
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#9333EA"/>
        <SolidColorBrush x:Key="AccentPurpleLightBrush" Color="#C084FC"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#06B6D4"/>
        <SolidColorBrush x:Key="StatusEmeraldBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="StatusAmberBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="StatusRoseBrush" Color="#F43F5E"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

        <LinearGradientBrush x:Key="PrimaryCtaGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#9333EA" Offset="0.0"/>
            <GradientStop Color="#7C3AED" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BrandIconGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9333EA" Offset="0.0"/>
            <GradientStop Color="#4F46E5" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroBannerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#161229" Offset="0.0"/>
            <GradientStop Color="#0F121B" Offset="0.55"/>
            <GradientStop Color="#0D1624" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Single-Elevation Card Surface (Clean React Preview Card) -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Unified View Hero Banner Style -->
        <Style x:Key="HeroBannerBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeroBannerGradient}"/>
            <Setter Property="BorderBrush" Value="#3B2562"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Subtle Inner Container (No Heavy Nested Borders) -->
        <Style x:Key="SubtleInnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0A0D14"/>
            <Setter Property="BorderBrush" Value="#161B28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <!-- Sidebar Navigation Button with Vector Icon + Active Indicator + Optional Badge -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="NavIcon" Grid.Column="0"
                                      Data="{Binding Uid, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.7"
                                      Stretch="Uniform" Width="15" Height="15"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,6,0"/>
                                <Border x:Name="BadgeBorder" Grid.Column="2"
                                        Background="#1A2030" BorderBrush="#262F45" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="BadgeText"
                                               Text="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="9.5" FontWeight="SemiBold" Foreground="#94A3B8" FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141824"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F1638"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#582C8E"/>
                                <Setter Property="Foreground" Value="#D8B4FE"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="NavIcon" Property="Stroke" Value="#C084FC"/>
                                <Setter TargetName="BadgeBorder" Property="Background" Value="#2D1B4E"/>
                                <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#6B3FA0"/>
                                <Setter TargetName="BadgeText" Property="Foreground" Value="#E9D5FF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Purple Gradient like Preview) -->
        <Style x:Key="ActionPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryCtaGradient}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="ActionSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#141824"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#262F45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#1E2538"/>
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="#3B4764"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Language Pill Selector Button in Sidebar Footer -->
        <Style x:Key="LangQuickButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F121B"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#9333EA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smooth Telemetry ProgressBar -->
        <Style x:Key="TelemetryProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#181E2C"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0A0D14"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#1E2436"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#0F121B"/>
            <Setter Property="AlternatingRowBackground" Value="#0B0E16"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#161B28"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#121622"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#1E2436"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- ========================================================================= -->
        <!-- 1. DASHBOARD VIEW (React Preview Parity)                                  -->
        <!-- ========================================================================= -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <StackPanel DataContext="{Binding Workspace}">
                <!-- Hero Banner -->
                <Border Style="{StaticResource HeroBannerBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#2D1B4E" BorderBrush="#6B3FA0" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PERFIL DETECTADO: " FontSize="10" FontWeight="Bold" Foreground="#C084FC"/>
                                        <TextBlock Text="{Binding DetectedProfileDisplay}" FontSize="10" FontWeight="Bold" Foreground="#E9D5FF"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#0D2824" BorderBrush="#115E59" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding HardwareSubsystemStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <Border Background="#141824" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="DETECÇÃO REAL MULTI-FONTE" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" FontFamily="Consolas"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Visão Geral do Sistema" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding SecurityPostureText}" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ActionSecondaryButton}" Command="{Binding CreateSnapshotCommand}" Margin="0,0,10,0">
                                <TextBlock Text="Criar Ponto de Restauração"/>
                            </Button>
                            <Button Style="{StaticResource ActionPrimaryButton}" Command="{Binding SelectTabCommand}" CommandParameter="boost-center">
                                <TextBlock Text="Ir para Boost Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4 Hardware KPI Cards (CPU, GPU, RAM, Storage) -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <!-- Card 1: CPU -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="PROCESSADOR (CPU)" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding CpuLoad}" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                            </Grid>
                            <TextBlock Text="{Binding CpuModel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" ToolTip="{Binding CpuModel}"/>
                            <TextBlock Text="{Binding CpuCoresThreadsText}" FontSize="11" Foreground="#64748B" Margin="0,2,0,12"/>
                            <ProgressBar Style="{StaticResource TelemetryProgressBar}" Value="{Binding CpuLoadPercent}" Foreground="#A855F7" Margin="0,0,0,12"/>
                            <Border BorderBrush="#161B28" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding CpuTemp}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding CpuClock}" HorizontalAlignment="Right" FontSize="11" Foreground="#C084FC" FontFamily="Consolas"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: GPU -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="PLACA DE VÍDEO (GPU)" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding GpuLoad}" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                            </Grid>
                            <TextBlock Text="{Binding GpuModel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuModel}"/>
                            <TextBlock Text="{Binding GpuVram}" FontSize="11" Foreground="#64748B" Margin="0,2,0,12"/>
                            <ProgressBar Style="{StaticResource TelemetryProgressBar}" Value="{Binding GpuLoadPercent}" Foreground="#06B6D4" Margin="0,0,0,12"/>
                            <Border BorderBrush="#161B28" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding GpuTemp}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding GpuHotspot}" HorizontalAlignment="Right" FontSize="11" Foreground="#F59E0B" FontFamily="Consolas"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: RAM -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="MEMÓRIA RAM" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding RamUsagePercent, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                            </Grid>
                            <TextBlock Text="{Binding RamTotalAndTypeText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding RamUsage}" FontSize="11" Foreground="#64748B" Margin="0,2,0,12"/>
                            <ProgressBar Style="{StaticResource TelemetryProgressBar}" Value="{Binding RamUsagePercent}" Foreground="#10B981" Margin="0,0,0,12"/>
                            <Border BorderBrush="#161B28" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding RamUsedText, StringFormat=Em uso: {0}}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding RamAvailableText, StringFormat=Livre: {0}}" HorizontalAlignment="Right" FontSize="11" Foreground="#34D399" FontFamily="Consolas"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Storage -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="ARMAZENAMENTO" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding PrimaryDiskUsagePercent, StringFormat={}{0:F0}%}" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                            </Grid>
                            <TextBlock Text="{Binding PrimaryDiskModel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PrimaryDiskModel}"/>
                            <TextBlock Text="{Binding PrimaryDiskSmartStatus}" FontSize="11" Foreground="#10B981" Margin="0,2,0,12"/>
                            <ProgressBar Style="{StaticResource TelemetryProgressBar}" Value="{Binding PrimaryDiskUsagePercent}" Foreground="#6366F1" Margin="0,0,0,12"/>
                            <Border BorderBrush="#161B28" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding PrimaryDiskFreeSpaceText, StringFormat=Livre: {0}}" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding PrimaryDiskTotalSpaceText, StringFormat=Total: {0}}" HorizontalAlignment="Right" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 2 Real-Time Vector Telemetry Charts (Matching DashboardView.tsx) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chart 1: CPU & GPU Load Real-Time Vector Polyline -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Telemetria de Carga em Tempo Real (CPU &amp; GPU)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Amostras reais contínuas capturadas dos sensores físicos" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#A855F7" Margin="0,0,5,0"/>
                                    <TextBlock Text="CPU %" FontSize="11" Foreground="#94A3B8" Margin="0,0,12,0"/>
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#06B6D4" Margin="0,0,5,0"/>
                                    <TextBlock Text="GPU %" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="#090C14" BorderBrush="#181E2C" BorderThickness="1" CornerRadius="8" Height="156" Padding="8">
                                <Grid>
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="500" Height="140" ClipToBounds="True">
                                            <Line X1="0" Y1="35" X2="500" Y2="35" Stroke="#141926" StrokeThickness="1"/>
                                            <Line X1="0" Y1="70" X2="500" Y2="70" Stroke="#141926" StrokeThickness="1"/>
                                            <Line X1="0" Y1="105" X2="500" Y2="105" Stroke="#141926" StrokeThickness="1"/>
                                            <Polyline Points="{Binding CpuLoadChartPoints}" Stroke="#A855F7" StrokeThickness="2.4" StrokeLineJoin="Round"/>
                                            <Polyline Points="{Binding GpuLoadChartPoints}" Stroke="#06B6D4" StrokeThickness="2.2" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Chart 2: Thermal Telemetry & Hotspot Diagnosis -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Estabilidade Térmica &amp; Diagnóstico Hotspot ΔT" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding GpuThermalDiagnosisText}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1E1B2E" BorderBrush="#4C1D95" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <TextBlock Text="{Binding GpuHotspotDeltaText, StringFormat=ΔT: {0}}" FontSize="11" FontWeight="Bold" Foreground="#C084FC" FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                            <Border Background="#090C14" BorderBrush="#181E2C" BorderThickness="1" CornerRadius="8" Height="156" Padding="8">
                                <Grid>
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="500" Height="140" ClipToBounds="True">
                                            <Line X1="0" Y1="35" X2="500" Y2="35" Stroke="#141926" StrokeThickness="1"/>
                                            <Line X1="0" Y1="70" X2="500" Y2="70" Stroke="#141926" StrokeThickness="1"/>
                                            <Line X1="0" Y1="105" X2="500" Y2="105" Stroke="#141926" StrokeThickness="1"/>
                                            <Polyline Points="{Binding CpuTempChartPoints}" Stroke="#10B981" StrokeThickness="2.4" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bottom Row: Recommendations + System Summary -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Recomendações Inteligentes Baseadas em Evidências" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource ActionSecondaryButton}" Command="{Binding GenerateDiagnosticInsightsCommand}" Padding="10,5">
