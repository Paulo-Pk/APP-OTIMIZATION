                            <TextBlock Text="MODO RECOMENDADO" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                            <TextBlock Text="Safe Boost" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,6"/>
                            <TextBlock Text="Aplica apenas otimizações classificadas como Seguras com zero impacto em estabilidade do Windows." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>
