                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding AssistantDiagnosticInsights}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SubtleInnerCardStyle}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
