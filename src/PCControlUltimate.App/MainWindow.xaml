                                        <TextBlock Text="Menor Latência de Agendamento" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="0,4,0,6" />
                                        <TextBlock Text="Otimiza GameDVR, SystemResponsiveness e prioridade multimídia preservando serviços críticos." Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
