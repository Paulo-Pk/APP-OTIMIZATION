        <!-- ========================================================================= -->
        <!-- 5. GAME CENTER VIEW TEMPLATE                                              -->
        <!-- ========================================================================= -->
        <DataTemplate DataType="{x:Type vm:GameCenterViewModel}">
            <views:GameCenterView>
                <StackPanel>
                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Workspace.Loc[GameCenterTitle]}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Workspace.Loc[GameCenterSubtitle]}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource ActionPrimaryButton}" Content="{Binding Workspace.Loc[BtnDetectGameSockets]}" Command="{Binding Workspace.RefreshGameConnectionsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding Workspace.DetectedGameSockets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0A0C13" BorderBrush="#1E2436" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding GameTitle}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" />
