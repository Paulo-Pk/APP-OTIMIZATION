                                <TextBlock Text="Configurar Ajustes"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="MULTITAREFA &amp; CRIAÇÃO" FontSize="10" FontWeight="Bold" Foreground="#06B6D4"/>
                            <TextBlock Text="Workstation Pro" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,6"/>
                            <TextBlock Text="Equilibra throughput de I/O, gerenciamento de memória e estabilidade contínua sob carga." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <Button Style="{StaticResource ActionSecondaryButton}" Command="{Binding SelectTabCommand}" CommandParameter="tweaks" HorizontalAlignment="Stretch">
                                <TextBlock Text="Ver Catálogo"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="REVERSÃO INTEGRAL" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                            <TextBlock Text="Restore &amp; Rollback" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,6"/>
