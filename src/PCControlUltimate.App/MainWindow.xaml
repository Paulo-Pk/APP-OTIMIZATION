<Window x:Class="PCControlUltimate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC CONTROL ULTIMATE v2.4.0 — Windows 10/11 x64 Native Suite"
        Height="860" Width="1360"
        MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#07090E">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBackground" Color="#0B0E17" />
        <SolidColorBrush x:Key="HeaderBackground" Color="#0F121B" />
        <SolidColorBrush x:Key="CardBackground" Color="#131722" />
        <SolidColorBrush x:Key="BorderDark" Color="#1E2333" />
        <SolidColorBrush x:Key="PrimaryPurple" Color="#A855F7" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#16A34A" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E1B4B" />
                    <Setter Property="Foreground" Value="#C084FC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#A855F7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#9333EA" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PC CONTROL ULTIMATE" Foreground="#FFFFFF" FontWeight="Black" FontSize="18" />
                    <TextBlock Text=" · v2.4.0 x64" Foreground="#C084FC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#86EFAC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Style="{StaticResource ActionPrimaryButton}" Content="PT-BR / EN-US" Command="{Binding ToggleLanguageCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource ActionPrimaryButton}" Content="Elevar UAC" Command="{Binding RequestElevationCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource ActionPrimaryButton}" Content="Backup dos Ajustes" Command="{Binding CreateSnapshotCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0" Padding="14,18">
                <StackPanel>
                    <TextBlock Text="NAVEGAÇÃO" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="8,0,0,10" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="01. Painel &amp; Sensores Reais" Command="{Binding SelectTabCommand}" CommandParameter="dashboard" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="02. Catálogo de Registro" Command="{Binding SelectTabCommand}" CommandParameter="tweaks" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="03. Debloat &amp; Limpeza Segura" Command="{Binding SelectTabCommand}" CommandParameter="debloat" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="04. PresentMon &amp; Display" Command="{Binding SelectTabCommand}" CommandParameter="gaming" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="05. Restore &amp; Backups SHA-256" Command="{Binding SelectTabCommand}" CommandParameter="restore" />

                    <Separator Background="{StaticResource BorderDark}" Margin="0,14" />

                    <TextBlock Text="ESTADO DO BACKUP" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="8,0,0,6" />
                    <Border Background="#131722" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBlock Text="{Binding LastBackupStatus}" Foreground="#E2E8F0" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28">
                <StackPanel>
                    <!-- Action & Telemetry Header -->
                    <Border Background="#0F121C" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding HeaderTitle}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Leituras diretas de hardware e operações verificadas por releitura no Registro." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ActionPrimaryButton}" Content="Atualizar Sensores e Estado" Command="{Binding RefreshStatusCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Real Hardware Sensor Grid (Zero Fake Values) -->
                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="CPU (MODELO / TEMP)" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding CpuTemp}" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Margin="0,6,0,4" />
                                <TextBlock Text="{Binding CpuModel}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="GPU (CORE / HOTSPOT)" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                    <TextBlock Text="{Binding GpuTemp}" Foreground="#F43F5E" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                    <TextBlock Text=" · " Foreground="#64748B" FontSize="20" />
                                    <TextBlock Text="{Binding GpuHotspot}" Foreground="#F59E0B" FontSize="20" FontWeight="Bold" FontFamily="Consolas" />
                                </StackPanel>
                                <TextBlock Text="{Binding GpuModel}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="MEMÓRIA RAM REAL" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding RamUsage}" Foreground="#A855F7" FontSize="20" FontWeight="Bold" FontFamily="Consolas" Margin="0,6,0,4" />
                                <TextBlock Text="Uso Físico Detectado" Foreground="#94A3B8" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="MONITOR PRIMÁRIO (WIN32)" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding DisplayInfoText}" Foreground="#22C55E" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Margin="0,8,0,4" TextWrapping="Wrap" />
                                <TextBlock Text="EnumDisplayDevicesW / SettingsW" Foreground="#94A3B8" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Debloat & PresentMon Controls Row -->
                    <UniformGrid Columns="2" Margin="0,0,0,20">
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="LIMPEZA CONTROLADA DE DISCO (ANTI-SYMLINK)" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" />
                                <TextBlock Text="{Binding DebloatEstimateText}" Foreground="#94A3B8" FontSize="12" FontFamily="Consolas" Margin="0,6,0,2" />
                                <TextBlock Text="{Binding DebloatFreedText}" Foreground="#22C55E" FontSize="12" FontFamily="Consolas" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionPrimaryButton}" Content="Estimar Caches" Command="{Binding ScanDebloatCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource ActionPrimaryButton}" Content="Limpar Temp Usuário" Command="{Binding PurgeTempUserCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="TELEMETRIA DE QUADROS INTEL PRESENTMON" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" />
                                <TextBlock Text="{Binding PresentMonStatusText}" Foreground="#94A3B8" FontSize="12" FontFamily="Consolas" Margin="0,6,0,12" TextWrapping="Wrap" />
                                <Button Style="{StaticResource ActionPrimaryButton}" Content="Verificar Instalação PresentMon" Command="{Binding CheckPresentMonCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Authorized Registry Catalog List -->
                    <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="CATÁLOGO CONTROLADO DE OTIMIZAÇÕES DO REGISTRO (WHITELIST)" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding CatalogTweaks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1E2333" BorderThickness="0,0,0,1" Padding="8,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TweakId}" Foreground="#C084FC" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="8,0">
                                                    <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding RegistryPath}" Foreground="#64748B" FontSize="11" FontFamily="Consolas" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding VerificationState}" Foreground="#94A3B8" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Style="{StaticResource ActionPrimaryButton}" Content="Aplicar e Verificar"
                                                        Command="{Binding DataContext.ApplyTweakCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="PC Control Ultimate v2.4.0 · Solução Nativa .NET 10 WPF · Proteção DPAPI e Reversibilidade Fiel" Foreground="#64748B" FontSize="11" />
                <TextBlock Grid.Column="1" Text="IPC Loopback: 127.0.0.1:52194" Foreground="#64748B" FontSize="11" FontFamily="Consolas" />
            </Grid>
        </Border>
    </Grid>
</Window>